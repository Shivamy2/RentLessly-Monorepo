{
    "$schema": "https://turbo.build/schema.json",
    "pipeline": {
        "build": {
            "outputs": [
                "dist/**",
                ".next/**",
                "build/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "lint": {
            "outputs": []
        },
        "test": {
            "outputs": [
                "coverage/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "prisma:generate": {
            "outputs": [
                "node_modules/@prisma/**"
            ]
        },
        "prisma:migrate": {
            "cache": false
        }
    },
    "globalDependencies": [
        "package.json",
        ".env",
        ".env.local"
    ]
}