# Rent Lessly API Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rent_lessly"

# JWT Secrets (generate with: openssl rand -base64 32)
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Cloudflare R2 (File Upload)
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=rent-lessly
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000,https://rentlessly.app
